---
import { Image, getImage } from "astro:assets"
import Layout from "@/layouts/Layout.astro"
import RouteMethod, { type Stage } from "@/components/RouteMethod"
import ContactChat from "@/components/ContactChat"
import { ArrowRight, Mail, MessageCircle } from "lucide-react"

import logo from "@/assets/logo.png"
import hero from "@/assets/images/hero.jpg"
import diagnosticoEstrategia from "@/assets/images/diagnostico-estrategia.jpg"
import desenvolvimentoProduto from "@/assets/images/desenvolvimento-produto.jpg"
import brandingDesign from "@/assets/images/branding-design.jpg"
import embalagem from "@/assets/images/embalagem.jpg"
import registrosRegulatorio from "@/assets/images/registros-regulatorio.jpg"
import producaoLogistica from "@/assets/images/producao-logistica.png"
import lancamentoSuporte from "@/assets/images/lancamento-suporte.png"
import verticalCafe from "@/assets/images/vertical-cafe.jpg"
import segmentoCafeterias from "@/assets/images/segmento-cafeterias.png"
import segmentoEmporios from "@/assets/images/segmento-emporios.png"
import segmentoDistribuidores from "@/assets/images/segmento-distribuidores.png"
import segmentoRedesSupermercados from "@/assets/images/segmento-redes-supermercados.png"
import segmentoEmpresasEscritorios from "@/assets/images/segmento-empresas-escritorios.jpg"
import segmentoCriadoresEmpreendedores from "@/assets/images/segmento-criadores-empreendedores.jpg"

const stageSources = [
	{ numero: "01", titulo: "Diagnóstico & Estratégia", icone: "compass", imagem: diagnosticoEstrategia },
	{ numero: "02", titulo: "Desenvolvimento de Produto", icone: "flask-conical", imagem: desenvolvimentoProduto },
	{ numero: "03", titulo: "Branding & Design", icone: "palette", imagem: brandingDesign },
	{ numero: "04", titulo: "Embalagem", icone: "package-check", imagem: embalagem },
	{ numero: "05", titulo: "Registros & Regulatório", icone: "shield-check", imagem: registrosRegulatorio },
	{ numero: "06", titulo: "Produção & Logística", icone: "factory", imagem: producaoLogistica },
	{ numero: "07", titulo: "Lançamento & Suporte", icone: "rocket", imagem: lancamentoSuporte },
] as const

const stages: Stage[] = await Promise.all(
	stageSources.map(async (s) => {
		const optimized = await getImage({ src: s.imagem, width: 480, height: 600, format: "webp" })
		return {
			numero: s.numero,
			titulo: s.titulo,
			icone: s.icone,
			imagemSrc: optimized.src,
			imagemAlt: s.titulo,
		}
	})
)

const segmentos = [
	{ titulo: "Cafeterias e restaurantes", imagem: segmentoCafeterias },
	{ titulo: "Empórios e mercados especializados", imagem: segmentoEmporios },
	{ titulo: "Distribuidores e atacadistas", imagem: segmentoDistribuidores },
	{ titulo: "Redes e supermercados", imagem: segmentoRedesSupermercados },
	{ titulo: "Empresas e escritórios", imagem: segmentoEmpresasEscritorios },
	{ titulo: "Criadores e empreendedores", imagem: segmentoCriadoresEmpreendedores },
]
---

<Layout
	title="GA Food Wholesaler — Private Label & Brand Development"
	description="Você tem a ideia. Nós cuidamos do resto. Uma rota só, do diagnóstico ao lançamento, pra transformar sua ideia numa marca própria real."
>
	<header class="fixed inset-x-0 top-0 z-50 border-b border-border bg-background/90 backdrop-blur-md">
		<div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-2.5">
			<a href="#" class="flex shrink-0 items-center gap-3">
				<Image src={logo} alt="GA Food Wholesaler" class="h-11 w-auto md:h-12" />
				<span class="hidden border-l border-border pl-3 text-xs leading-tight text-muted-foreground sm:block">
					Private Label<br />&amp; Brand Development
				</span>
			</a>
			<nav class="hidden items-center gap-8 text-sm text-muted-foreground md:flex">
				<a href="#metodo" class="transition-colors hover:text-foreground">Método</a>
				<a href="#cafe" class="transition-colors hover:text-foreground">Café Private Label</a>
				<a href="#segmentos" class="transition-colors hover:text-foreground">Para quem é</a>
			</nav>
			<a
				href="#contato"
				class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition-transform hover:scale-[1.03] active:scale-95"
			>
				Falar com um especialista
			</a>
		</div>
	</header>

	<main>
		<section class="relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden bg-muted pb-24 pt-32">
			<Image
				src={hero}
				alt="Fundador da GA Food avaliando embalagens private label"
				class="absolute inset-0 z-0 h-full w-full object-cover"
				widths={[768, 1280, 1920, 2752]}
				sizes="100vw"
				loading="eager"
				fetchpriority="high"
			/>
			<div class="absolute inset-0 z-10 bg-gradient-to-t from-foreground via-foreground/65 to-foreground/25"></div>

			<div class="relative z-20 mx-auto w-full max-w-6xl px-6">
				<div class="max-w-3xl">
					<h1 class="text-[clamp(2.75rem,7vw,6rem)] leading-[0.95] font-semibold tracking-[-0.03em] text-balance text-primary-foreground">
						Você tem a ideia.<br />Nós cuidamos do resto.
					</h1>
					<p class="mt-7 max-w-lg text-lg font-light tracking-wide text-primary-foreground/60">
						Não é só colocar sua marca em um produto. É construir um negócio que é seu — com a
						margem, o preço e o posicionamento que só você decide.
					</p>
					<div class="mt-10 flex flex-wrap items-center gap-4">
						<a
							href="#contato"
							class="inline-flex h-12 items-center justify-center gap-2 rounded-md bg-primary px-7 text-sm font-medium text-primary-foreground shadow-[0_8px_30px_-8px_rgba(138,109,80,0.6)] transition-transform hover:scale-[1.03] active:scale-95"
						>
							Desenvolver minha marca própria
							<ArrowRight className="size-4" />
						</a>
						<a
							href="#contato"
							class="inline-flex h-12 items-center justify-center gap-2 rounded-md border border-primary-foreground/25 px-7 text-sm font-medium text-primary-foreground transition-colors hover:border-primary-foreground/60 hover:bg-primary-foreground/5"
						>
							Falar com um especialista
						</a>
					</div>
				</div>
			</div>

			<div class="absolute bottom-0 left-6 z-20 h-24 w-px bg-gradient-to-b from-transparent to-primary md:left-1/2"></div>
		</section>

		<section class="bg-background py-28">
			<div class="mx-auto max-w-6xl px-6">
				<div class="grid items-center gap-14 md:grid-cols-2">
					<div>
						<h2 class="text-3xl leading-[1.1] font-semibold text-balance text-foreground sm:text-4xl">
							Colocar sua marca em um produto é só o começo. Construir uma marca de verdade é o
							negócio.
						</h2>
						<p class="mt-6 max-w-lg text-muted-foreground">
							Com a GA Food Wholesaler, você personaliza produtos de alta qualidade, adaptados às
							suas especificações e alinhados à identidade da sua marca — mas o que muda de
							verdade vai além da embalagem. É sair da posição de quem revende a marca de outra
							empresa e passar a construir a sua: com a margem que hoje fica com terceiros, o
							preço que você define e um produto que só você pode vender de novo, do jeito que
							quiser. A GA Food entrega a estrutura pra isso acontecer — do diagnóstico ao
							produto na prateleira — sem que você precise montar essa engrenagem sozinho.
						</p>
					</div>
					<figure class="w-full">
						<div class="aspect-4/5 w-full overflow-hidden">
							<Image
								src={diagnosticoEstrategia}
								alt="Equipe da GA Food em reunião de diagnóstico e estratégia de marca"
								class="h-full w-full object-cover"
								widths={[480, 768, 1024]}
								sizes="(min-width: 768px) 480px, 100vw"
							/>
						</div>
						<figcaption class="mt-3 text-xs tracking-wide text-muted-foreground uppercase">
							Fig. 01 — Diagnóstico &amp; Estratégia
						</figcaption>
					</figure>
				</div>
			</div>
		</section>

		<section id="metodo" class="bg-secondary py-28">
			<div class="mx-auto max-w-6xl px-6">
				<div class="mx-auto max-w-2xl text-center">
					<h2 class="text-4xl font-semibold text-foreground sm:text-5xl">Private Label 360°.</h2>
					<p class="mt-5 text-muted-foreground">
						Sete etapas, uma rota só. Cada estágio tem equipe e processo próprios — nenhum foi
						pensado pra funcionar sozinho.
					</p>
				</div>

				<div class="mt-24">
					<RouteMethod stages={stages} client:visible />
				</div>
			</div>
		</section>

		<section id="cafe" class="bg-background py-28">
			<div class="mx-auto max-w-6xl px-6">
				<div class="grid items-center gap-14 md:grid-cols-2">
					<figure class="w-full md:order-2">
						<div class="aspect-4/5 w-full overflow-hidden">
							<Image
								src={verticalCafe}
								alt="Sessão de degustação técnica de café private label"
								class="h-full w-full object-cover"
								widths={[480, 768, 1024]}
								sizes="(min-width: 768px) 480px, 100vw"
							/>
						</div>
						<figcaption class="mt-3 text-xs tracking-wide text-muted-foreground uppercase">
							Fig. 02 — Café Private Label
						</figcaption>
					</figure>
					<div class="md:order-1">
						<h2 class="text-3xl leading-[1.1] font-semibold text-balance text-foreground sm:text-4xl">
							Café Private Label
						</h2>
						<p class="mt-6 max-w-md text-muted-foreground">
							Café é onde nossa curadoria, torra e degustação técnica mostram o padrão que
							aplicamos a qualquer produto que passa pela nossa esteira — não é o limite do que
							fazemos, é a prova.
						</p>
						<a
							href="#contato"
							class="mt-8 inline-flex items-center gap-2 text-sm font-medium text-primary hover:underline"
						>
							Falar sobre a linha de café
							<ArrowRight className="size-4" />
						</a>
					</div>
				</div>
			</div>
		</section>

		<section id="segmentos" class="bg-muted py-28">
			<div class="mx-auto max-w-6xl px-6">
				<h2 class="max-w-xl text-3xl font-semibold text-balance text-foreground sm:text-4xl">
					Seis públicos. Uma mesma estrutura.
				</h2>

				<div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
					{
						segmentos.map((segmento) => (
							<a
								href="#contato"
								class="group relative block aspect-4/5 overflow-hidden rounded-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
							>
								<Image
									src={segmento.imagem}
									alt=""
									class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
									widths={[320, 480, 640]}
									sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
								/>
								<div class="absolute inset-0 bg-gradient-to-t from-foreground/85 via-foreground/10 to-transparent" />
								<p class="absolute right-5 bottom-5 left-5 text-lg font-medium text-primary-foreground">
									{segmento.titulo}
								</p>
							</a>
						))
					}
				</div>
			</div>
		</section>

		<section id="contato" class="bg-secondary py-28">
			<div class="mx-auto max-w-3xl px-6 text-center">
				<h2 class="text-4xl leading-[1.1] font-semibold text-balance text-foreground sm:text-5xl">
					Sua marca. Seu produto. Nossa estrutura.
				</h2>
				<p class="mt-6 text-muted-foreground">
					Conta pra gente o que você quer colocar no mercado. A resposta vem com os próximos
					passos reais do diagnóstico — não com uma proposta genérica.
				</p>

				<div class="mt-10">
					<ContactChat whatsappNumber="5531967777753" client:visible />
				</div>

				<div class="mt-16">
					<p class="text-xs font-medium tracking-[0.15em] text-muted-foreground uppercase">
						Nossos canais de relacionamento
					</p>
					<div class="mt-5 grid gap-4 sm:grid-cols-3">
						<a
							href="mailto:tranding@gafood.com.br"
							class="group flex flex-col items-center gap-2 rounded-xl border border-border bg-background px-5 py-6 transition-colors hover:border-primary/60"
						>
							<span class="flex size-11 items-center justify-center rounded-full bg-secondary text-primary transition-colors group-hover:bg-primary group-hover:text-primary-foreground">
								<Mail className="size-5" />
							</span>
							<span class="text-sm font-medium text-foreground">E-mail</span>
							<span class="text-xs text-muted-foreground">tranding@gafood.com.br</span>
						</a>
						<a
							href="https://wa.me/5531967777753"
							target="_blank"
							rel="noopener noreferrer"
							class="group flex flex-col items-center gap-2 rounded-xl border border-border bg-background px-5 py-6 transition-colors hover:border-primary/60"
						>
							<span class="flex size-11 items-center justify-center rounded-full bg-secondary text-primary transition-colors group-hover:bg-primary group-hover:text-primary-foreground">
								<MessageCircle className="size-5" />
							</span>
							<span class="text-sm font-medium text-foreground">WhatsApp</span>
							<span class="text-xs text-muted-foreground">31 96777-7753</span>
						</a>
						<a
							href="https://instagram.com/gafoodb2b"
							target="_blank"
							rel="noopener noreferrer"
							class="group flex flex-col items-center gap-2 rounded-xl border border-border bg-background px-5 py-6 transition-colors hover:border-primary/60"
						>
							<span class="flex size-11 items-center justify-center rounded-full bg-secondary text-primary transition-colors group-hover:bg-primary group-hover:text-primary-foreground">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"
									class="size-5"
								>
									<rect x="3" y="3" width="18" height="18" rx="5" />
									<circle cx="12" cy="12" r="4" />
									<circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none" />
								</svg>
							</span>
							<span class="text-sm font-medium text-foreground">Instagram</span>
							<span class="text-xs text-muted-foreground">@gafoodb2b</span>
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>

	<footer class="bg-secondary pb-10">
		<div class="mx-auto flex max-w-6xl flex-col items-center justify-center gap-3 px-6">
			<div class="h-10 w-px bg-gradient-to-b from-primary to-transparent"></div>
			<Image src={logo} alt="GA Food Wholesaler" class="h-9 w-auto" />
			<p class="text-xs text-muted-foreground">Private Label &amp; Brand Development</p>
			<p class="text-xs text-muted-foreground">© {new Date().getFullYear()} GA Food. Todos os direitos reservados.</p>
		</div>
	</footer>
</Layout>
