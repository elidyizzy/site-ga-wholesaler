---
import { Image, getImage } from "astro:assets"
import Layout from "@/layouts/Layout.astro"
import RouteMethod, { type Stage } from "@/components/RouteMethod"
import ContactChat from "@/components/ContactChat"
import { ArrowRight } from "lucide-react"

import logo from "@/assets/logo.png"
import logoWhite from "@/assets/logo-white.png"
import hero from "@/assets/images/hero.jpg"
import diagnosticoEstrategia from "@/assets/images/diagnostico-estrategia.jpg"
import desenvolvimentoProduto from "@/assets/images/desenvolvimento-produto.jpg"
import brandingDesign from "@/assets/images/branding-design.jpg"
import embalagem from "@/assets/images/embalagem.jpg"
import registrosRegulatorio from "@/assets/images/registros-regulatorio.jpg"
import producaoLogistica from "@/assets/images/producao-logistica.png"
import lancamentoSuporte from "@/assets/images/lancamento-suporte.png"
import verticalCafe from "@/assets/images/vertical-cafe.jpg"
import segmentoCafeterias from "@/assets/images/segmento-cafeterias.png"
import segmentoEmporios from "@/assets/images/segmento-emporios.png"
import segmentoDistribuidores from "@/assets/images/segmento-distribuidores.png"
import segmentoRedesSupermercados from "@/assets/images/segmento-redes-supermercados.png"
import segmentoEmpresasEscritorios from "@/assets/images/segmento-empresas-escritorios.jpg"
import segmentoCriadoresEmpreendedores from "@/assets/images/segmento-criadores-empreendedores.jpg"

const stageSources = [
	{
		numero: "01",
		titulo: "Diagnóstico & Estratégia",
		descricao: "Ideia, público, canal e objetivo mapeados pra definir o caminho certo do projeto.",
		icone: "diagnostico",
		imagem: diagnosticoEstrategia,
	},
	{
		numero: "02",
		titulo: "Desenvolvimento de Produto",
		descricao: "Curadoria de matéria-prima, blends e especificações até chegar num produto viável.",
		icone: "produto",
		imagem: desenvolvimentoProduto,
	},
	{
		numero: "03",
		titulo: "Branding & Design",
		descricao: "Naming, identidade e conceito que criam a diferenciação da marca.",
		icone: "branding",
		imagem: brandingDesign,
	},
	{
		numero: "04",
		titulo: "Embalagem",
		descricao: "Formato, material e rotulagem que transformam produto em apresentação de mercado.",
		icone: "embalagem",
		imagem: embalagem,
	},
	{
		numero: "05",
		titulo: "Registros & Regulatório",
		descricao: "Propriedade intelectual, INPI e exigências regulatórias resolvidas antes de virarem risco.",
		icone: "regulatorio",
		imagem: registrosRegulatorio,
	},
	{
		numero: "06",
		titulo: "Produção & Logística",
		descricao: "Produção, controle de qualidade e logística com o padrão e a escala que o projeto pede.",
		icone: "producao",
		imagem: producaoLogistica,
	},
	{
		numero: "07",
		titulo: "Lançamento & Suporte",
		descricao: "Materiais e suporte pra transformar o produto lançado em negócio de verdade.",
		icone: "lancamento",
		imagem: lancamentoSuporte,
	},
] as const

const stages: Stage[] = await Promise.all(
	stageSources.map(async (s) => {
		const optimized = await getImage({ src: s.imagem, width: 720, height: 900, format: "webp" })
		return {
			numero: s.numero,
			titulo: s.titulo,
			descricao: s.descricao,
			icone: s.icone,
			imagemSrc: optimized.src,
			imagemAlt: s.titulo,
		}
	})
)

const segmentos = [
	{ titulo: "Cafeterias e restaurantes", descricao: "Produtos próprios e experiência.", imagem: segmentoCafeterias },
	{
		titulo: "Empórios e mercados especializados",
		descricao: "Linha exclusiva e diferenciação.",
		imagem: segmentoEmporios,
	},
	{
		titulo: "Distribuidores e atacadistas",
		descricao: "Portfólio próprio e novas margens.",
		imagem: segmentoDistribuidores,
	},
	{
		titulo: "Redes e supermercados",
		descricao: "Escala e padronização.",
		imagem: segmentoRedesSupermercados,
	},
	{ titulo: "Empresas e escritórios", descricao: "Produtos institucionais.", imagem: segmentoEmpresasEscritorios },
	{
		titulo: "Criadores e empreendedores",
		descricao: "Estrutura para tirar a ideia do papel.",
		imagem: segmentoCriadoresEmpreendedores,
	},
]
---

<Layout
	title="GA Food Wholesaler — Private Label & Brand Development"
	description="Você tem a ideia. Nós cuidamos do resto. Uma rota só, do diagnóstico ao lançamento, pra transformar sua ideia numa marca própria real."
>
	<header
		id="site-header"
		class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color,backdrop-filter] duration-500 ease-out"
	>
		<div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-2.5">
			<a href="#" class="relative flex shrink-0 items-center gap-3">
				<span class="relative block h-11 md:h-12">
					<Image src={logoWhite} alt="GA Food Wholesaler" class="header-logo header-logo--light h-11 w-auto md:h-12" />
					<Image
						src={logo}
						alt=""
						aria-hidden="true"
						class="header-logo header-logo--solid absolute inset-0 h-11 w-auto md:h-12"
					/>
				</span>
				<span class="header-tagline hidden pl-3 text-xs leading-tight sm:block">
					Private Label<br />&amp; Brand Development
				</span>
			</a>
			<nav class="header-nav hidden items-center gap-8 text-sm md:flex">
				<a href="#metodo">Método</a>
				<a href="#cafe">Café Private Label</a>
				<a href="#segmentos">Para quem é</a>
			</nav>
			<a
				href="#contato"
				class="inline-flex h-10 items-center justify-center rounded-full bg-primary px-5 text-sm font-medium text-primary-foreground shadow-[var(--shadow-lift-1)] transition-all hover:bg-primary/90 hover:shadow-[var(--shadow-lift-2)] active:scale-95"
			>
				Fale com um Consultor GA
			</a>
		</div>
		<div class="absolute inset-x-0 bottom-0 h-px overflow-hidden" aria-hidden="true">
			<div id="scroll-progress" class="h-full w-full origin-left scale-x-0 bg-primary"></div>
		</div>
	</header>

	<main>
		<section class="relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden bg-muted pb-24 pt-32">
			<Image
				id="hero-image"
				src={hero}
				alt="Fundador da GA Food avaliando embalagens private label"
				class="absolute inset-0 z-0 h-[118%] w-full object-cover will-change-transform"
				widths={[768, 1280, 1920, 2752]}
				sizes="100vw"
				loading="eager"
				fetchpriority="high"
			/>
			<div class="absolute inset-0 z-10 bg-gradient-to-t from-foreground via-foreground/65 to-foreground/25"></div>

			<div class="relative z-20 mx-auto w-full max-w-6xl px-6">
				<div class="max-w-3xl">
					<h1
						data-reveal
						class="text-[clamp(2.75rem,7vw,6rem)] leading-[0.95] font-light tracking-[-0.045em] text-balance text-primary-foreground"
					>
						Você tem a ideia.<br />Nós cuidamos do resto.
					</h1>
					<p
						data-reveal
						style="--reveal-delay:140ms"
						class="mt-7 max-w-lg text-lg font-light tracking-wide text-primary-foreground/60"
					>
						Não é só colocar sua marca em um produto. É construir um negócio que é seu — com a
						margem, o preço e o posicionamento que só você decide.
					</p>
					<div data-reveal style="--reveal-delay:260ms" class="mt-10 flex flex-wrap items-center gap-4">
						<a
							href="#contato"
							class="inline-flex h-12 items-center justify-center gap-2 rounded-full bg-primary px-7 text-sm font-medium text-primary-foreground shadow-[var(--shadow-lift-2)] transition-all hover:bg-primary/90 hover:shadow-[var(--shadow-lift-3)] active:scale-95"
						>
							Desenvolver minha marca própria
							<ArrowRight className="size-4" />
						</a>
						<a
							href="#contato"
							class="inline-flex h-12 items-center justify-center gap-2 rounded-full border border-primary-foreground/30 px-7 text-sm font-medium text-primary-foreground backdrop-blur-sm transition-colors hover:border-primary-foreground/70 hover:bg-primary-foreground/10"
						>
							Fale com um Consultor GA
						</a>
					</div>
				</div>
			</div>

			<div class="absolute bottom-0 left-6 z-20 h-24 w-px bg-gradient-to-b from-transparent to-primary md:left-1/2"></div>
		</section>

		<section class="bg-background">
			<div class="grid md:grid-cols-2 md:items-stretch">
				<div class="order-2 px-6 py-16 md:order-1 md:flex md:py-28 md:pr-14 md:pl-[max(1.5rem,calc((100vw-72rem)/2+1.5rem))] lg:pr-20">
					<div class="md:my-auto">
						<h2 class="text-3xl leading-[1.1] font-light tracking-[-0.03em] text-balance text-foreground sm:text-4xl">
							Colocar sua marca em um produto é só o começo. Construir uma marca de verdade é o
							negócio.
						</h2>
						<p class="mt-6 max-w-lg text-muted-foreground">
							Começamos pela necessidade, não pelo produto: entendemos o objetivo, selecionamos o
							caminho técnico e comercial certo e coordenamos a execução — do diagnóstico ao
							produto na prateleira, sem que você precise montar essa engrenagem sozinho.
						</p>

						<dl class="mt-10 max-w-lg space-y-5">
							<div class="flex gap-4">
								<dt class="w-1 shrink-0 rounded-full bg-primary" aria-hidden="true"></dt>
								<dd>
									<span class="block text-sm font-medium tracking-[-0.01em] text-primary">Margem</span>
									<span class="mt-0.5 block text-foreground">
										Fica com você, não com quem revende a marca de outra empresa.
									</span>
								</dd>
							</div>
							<div class="flex gap-4">
								<dt class="w-1 shrink-0 rounded-full bg-primary" aria-hidden="true"></dt>
								<dd>
									<span class="block text-sm font-medium tracking-[-0.01em] text-primary">Coordenação</span>
									<span class="mt-0.5 block text-foreground">
										Um parceiro cuida das sete etapas. Você foca em vender.
									</span>
								</dd>
							</div>
							<div class="flex gap-4">
								<dt class="w-1 shrink-0 rounded-full bg-primary" aria-hidden="true"></dt>
								<dd>
									<span class="block text-sm font-medium tracking-[-0.01em] text-primary">Risco</span>
									<span class="mt-0.5 block text-foreground">
										Registro e regulatório resolvidos antes de virarem prejuízo.
									</span>
								</dd>
							</div>
						</dl>
					</div>
				</div>
				<div class="order-1 aspect-4/3 md:order-2 md:aspect-auto">
					<Image
						src={diagnosticoEstrategia}
						alt="Equipe da GA Food em reunião de diagnóstico e estratégia de marca"
						class="h-full w-full object-cover"
						widths={[480, 768, 1024, 1440]}
						sizes="(min-width: 768px) 50vw, 100vw"
					/>
				</div>
			</div>
		</section>

		<section id="metodo" class="atmosphere-warm-soft bg-secondary py-28">
			<div class="mx-auto max-w-6xl px-6">
				<div class="mx-auto max-w-2xl text-center">
					<h2 class="text-4xl font-light tracking-[-0.04em] text-foreground sm:text-5xl">Private Label 360°.</h2>
					<p class="mt-5 text-muted-foreground">
						Sete etapas, cada uma com equipe e processo próprios. Contrate como projeto completo
						ou só a etapa que sua marca precisa agora.
					</p>
				</div>

				<div class="mt-24">
					<RouteMethod stages={stages} client:visible />
				</div>
			</div>
		</section>

		<section id="cafe" class="bg-background">
			<div class="grid md:grid-cols-2 md:items-stretch">
				<div class="order-1 aspect-4/3 md:order-2 md:aspect-auto">
					<Image
						src={verticalCafe}
						alt="Sessão de degustação técnica de café private label"
						class="h-full w-full object-cover"
						widths={[480, 768, 1024, 1440]}
						sizes="(min-width: 768px) 50vw, 100vw"
					/>
				</div>
				<div class="order-2 px-6 py-16 md:order-1 md:flex md:py-28 md:pr-14 md:pl-[max(1.5rem,calc((100vw-72rem)/2+1.5rem))] lg:pr-20">
					<div class="md:my-auto">
						<h2 class="text-3xl leading-[1.1] font-light tracking-[-0.03em] text-balance text-foreground sm:text-4xl">
							Café Private Label
						</h2>
						<p class="mt-6 max-w-md text-muted-foreground">
							Café é onde nossa curadoria, torra e degustação técnica mostram o padrão que
							aplicamos a qualquer produto que passa pela nossa esteira — não é o limite do que
							fazemos, é a prova.
						</p>
						<a
							href="#contato"
							class="mt-8 inline-flex items-center gap-2 text-sm font-medium text-primary hover:underline"
						>
							Falar sobre a linha de café
							<ArrowRight className="size-4" />
						</a>
					</div>
				</div>
			</div>
		</section>

		<section id="segmentos" class="bg-muted py-28">
			<div class="mx-auto max-w-6xl px-6">
				<h2 class="max-w-xl text-3xl font-light tracking-[-0.03em] text-balance text-foreground sm:text-4xl">
					Seis públicos. Uma mesma estrutura.
				</h2>

				<div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
					{
						segmentos.map((segmento) => (
							<a
								href="#contato"
								class="group relative block aspect-4/5 overflow-hidden rounded-2xl shadow-[var(--shadow-lift-1)] transition-shadow duration-500 hover:shadow-[var(--shadow-lift-3)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
							>
								<Image
									src={segmento.imagem}
									alt=""
									class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
									widths={[320, 480, 640]}
									sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
								/>
								<div class="absolute inset-0 bg-gradient-to-t from-foreground/85 via-foreground/10 to-transparent transition-opacity duration-500 group-hover:opacity-0" />
								<div class="absolute inset-0 bg-gradient-to-t from-foreground/95 via-foreground/35 to-foreground/5 opacity-0 transition-opacity duration-500 group-hover:opacity-100" />
								<div class="absolute right-5 bottom-5 left-5 transition-transform duration-500 ease-out group-hover:-translate-y-1">
									<p class="text-lg font-medium tracking-[-0.01em] text-primary-foreground">{segmento.titulo}</p>
									<p class="mt-1 text-sm text-primary-foreground/70">{segmento.descricao}</p>
									<span class="mt-3 flex items-center gap-1.5 text-sm font-medium text-primary-foreground opacity-0 transition-all duration-500 ease-out group-hover:opacity-100">
										Falar sobre esse cenário
										<ArrowRight className="size-3.5" />
									</span>
								</div>
							</a>
						))
					}
				</div>
			</div>
		</section>

		<section id="contato" class="atmosphere-warm bg-secondary py-28">
			<div class="mx-auto max-w-3xl px-6 text-center">
				<h2 class="text-4xl leading-[1.1] font-light tracking-[-0.04em] text-balance text-foreground sm:text-5xl">
					Sua marca. Seu produto. Nossa estrutura.
				</h2>
				<p class="mt-6 text-muted-foreground">
					Conta pra gente o que você quer colocar no mercado. A resposta vem com os próximos
					passos reais do diagnóstico — não com uma proposta genérica.
				</p>

				<div class="mt-10">
					<ContactChat whatsappNumber="5531967777753" client:visible />
				</div>

				<p class="mt-8 text-sm text-muted-foreground">
					Prefere outro canal?
					<a href="mailto:tranding@gafood.com.br" class="text-primary underline-offset-4 hover:underline">
						E-mail
					</a>
					<span class="px-1.5 text-border">·</span>
					<a
						href="https://wa.me/5531967777753"
						target="_blank"
						rel="noopener noreferrer"
						class="text-primary underline-offset-4 hover:underline"
					>
						WhatsApp
					</a>
					<span class="px-1.5 text-border">·</span>
					<a
						href="https://instagram.com/gafoodb2b"
						target="_blank"
						rel="noopener noreferrer"
						class="text-primary underline-offset-4 hover:underline"
					>
						Instagram
					</a>
				</p>
			</div>
		</section>
	</main>

	<footer class="border-t border-border bg-secondary">
		<div class="mx-auto max-w-6xl px-6 pt-20 pb-10">
			<div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr]">
				<div>
					<Image src={logo} alt="GA Food Wholesaler" class="h-12 w-auto" />
					<p class="mt-4 max-w-xs text-sm leading-relaxed text-muted-foreground">
						Private Label &amp; Brand Development. Da ideia ao produto na prateleira, com uma
						estrutura só.
					</p>
				</div>

				<nav aria-label="Seções do site">
					<p class="text-xs font-medium tracking-[0.14em] text-foreground uppercase">Navegar</p>
					<ul class="mt-4 space-y-3 text-sm text-muted-foreground">
						<li><a href="#metodo" class="transition-colors hover:text-primary">Private Label 360°</a></li>
						<li><a href="#cafe" class="transition-colors hover:text-primary">Café Private Label</a></li>
						<li><a href="#segmentos" class="transition-colors hover:text-primary">Para quem é</a></li>
						<li><a href="#contato" class="transition-colors hover:text-primary">Falar com um consultor</a></li>
					</ul>
				</nav>

				<div>
					<p class="text-xs font-medium tracking-[0.14em] text-foreground uppercase">Contato</p>
					<ul class="mt-4 space-y-3 text-sm text-muted-foreground">
						<li>
							<a href="mailto:tranding@gafood.com.br" class="transition-colors hover:text-primary">
								tranding@gafood.com.br
							</a>
						</li>
						<li>
							<a
								href="https://wa.me/5531967777753"
								target="_blank"
								rel="noopener noreferrer"
								class="tabular-nums transition-colors hover:text-primary"
							>
								31 96777-7753
							</a>
						</li>
						<li>
							<a
								href="https://instagram.com/gafoodb2b"
								target="_blank"
								rel="noopener noreferrer"
								class="transition-colors hover:text-primary"
							>
								@gafoodb2b
							</a>
						</li>
					</ul>
				</div>
			</div>

			<div class="mt-16 flex flex-col gap-2 border-t border-border pt-6 sm:flex-row sm:items-center sm:justify-between">
				<p class="text-xs text-muted-foreground">
					© {new Date().getFullYear()} GA Food Wholesaler. Todos os direitos reservados.
				</p>
				<p class="text-xs text-muted-foreground">gafood.com.br</p>
			</div>
		</div>
	</footer>
</Layout>
