---
import { Image, getImage } from "astro:assets"
import Layout from "@/layouts/Layout.astro"
import RouteMethod, { type Stage } from "@/components/RouteMethod"
import ContactChat from "@/components/ContactChat"
import HeroAtmosphere from "@/components/HeroAtmosphere.astro"
import HeroPacote from "@/components/HeroPacote"
import PontosValor from "@/components/PontosValor"
import { ArrowRight } from "lucide-react"

import logo from "@/assets/logo.png"
import diagnosticoEstrategia from "@/assets/images/diagnostico-estrategia.jpg"
import desenvolvimentoProduto from "@/assets/images/desenvolvimento-produto.jpg"
import brandingDesign from "@/assets/images/branding-design.jpg"
import embalagem from "@/assets/images/embalagem.jpg"
import registrosRegulatorio from "@/assets/images/registros-regulatorio.jpg"
import producaoLogistica from "@/assets/images/producao-logistica.png"
import lancamentoSuporte from "@/assets/images/lancamento-suporte.png"
import blocoCafe1 from "@/assets/images/bloco-cafe-privatelabel.jpg"
import blocoCafe2 from "@/assets/images/bloco-cafe-privatelabel2.jpg"
import pacotePrivateLabel from "@/assets/images/pacote-private-label.png"
import segmentoCafeterias from "@/assets/images/segmento-cafeterias.png"
import segmentoEmporios from "@/assets/images/segmento-emporios.png"
import segmentoDistribuidores from "@/assets/images/segmento-distribuidores.png"
import segmentoRedesSupermercados from "@/assets/images/segmento-redes-supermercados.png"
import segmentoEmpresasEscritorios from "@/assets/images/segmento-empresas-escritorios.jpg"
import segmentoCriadoresEmpreendedores from "@/assets/images/segmento-criadores-empreendedores.jpg"

const stageSources = [
	{
		numero: "01",
		titulo: "Diagnóstico & Estratégia",
		descricao: "Ideia, público, canal e objetivo mapeados pra definir o caminho certo do projeto.",
		icone: "diagnostico",
		imagem: diagnosticoEstrategia,
	},
	{
		numero: "02",
		titulo: "Desenvolvimento de Produto",
		descricao: "Curadoria de matéria-prima, blends e especificações até chegar num produto viável.",
		icone: "produto",
		imagem: desenvolvimentoProduto,
	},
	{
		numero: "03",
		titulo: "Branding & Design",
		descricao: "Naming, identidade e conceito que criam a diferenciação da marca.",
		icone: "branding",
		imagem: brandingDesign,
	},
	{
		numero: "04",
		titulo: "Embalagem",
		descricao: "Formato, material e rotulagem que transformam produto em apresentação de mercado.",
		icone: "embalagem",
		imagem: embalagem,
	},
	{
		numero: "05",
		titulo: "Registros & Regulatório",
		descricao: "Propriedade intelectual, INPI e exigências regulatórias resolvidas antes de virarem risco.",
		icone: "regulatorio",
		imagem: registrosRegulatorio,
	},
	{
		numero: "06",
		titulo: "Produção & Logística",
		descricao: "Produção, controle de qualidade e logística com o padrão e a escala que o projeto pede.",
		icone: "producao",
		imagem: producaoLogistica,
	},
	{
		numero: "07",
		titulo: "Lançamento & Suporte",
		descricao: "Materiais e suporte pra transformar o produto lançado em negócio de verdade.",
		icone: "lancamento",
		imagem: lancamentoSuporte,
	},
] as const

const stages: Stage[] = await Promise.all(
	stageSources.map(async (s) => {
		const optimized = await getImage({ src: s.imagem, width: 720, height: 900, format: "webp" })
		return {
			numero: s.numero,
			titulo: s.titulo,
			descricao: s.descricao,
			icone: s.icone,
			imagemSrc: optimized.src,
			imagemAlt: s.titulo,
		}
	})
)

const pacoteOtimizado = await getImage({
	src: pacotePrivateLabel,
	width: 1020,
	format: "webp",
	quality: 90,
})

const segmentos = [
	{ titulo: "Cafeterias e restaurantes", descricao: "Produtos próprios e experiência.", imagem: segmentoCafeterias, className: "lg:col-span-2 lg:row-span-2" },
	{
		titulo: "Empórios e mercados especializados",
		descricao: "Linha exclusiva e diferenciação.",
		imagem: segmentoEmporios,
		className: "lg:col-span-1"
	},
	{
		titulo: "Distribuidores e atacadistas",
		descricao: "Portfólio próprio e novas margens.",
		imagem: segmentoDistribuidores,
		className: "lg:col-span-1"
	},
	{
		titulo: "Redes e supermercados",
		descricao: "Escala e padronização.",
		imagem: segmentoRedesSupermercados,
		className: "lg:col-span-1"
	},
	{ titulo: "Empresas e escritórios", descricao: "Produtos institucionais.", imagem: segmentoEmpresasEscritorios, className: "lg:col-span-1" },
	{
		titulo: "Criadores e empreendedores",
		descricao: "Estrutura para tirar a ideia do papel.",
		imagem: segmentoCriadoresEmpreendedores,
		className: "lg:col-span-1"
	},
]
---

<Layout
	title="GA Food Wholesaler | Private Label & Brand Development"
	description="Você tem a ideia. Nós cuidamos do resto. Uma rota só, do diagnóstico ao lançamento, pra transformar sua ideia numa marca própria real."
	image="/images/blog/como-criar-marca-propria-de-cafe.jpg"
>
	<header
		id="site-header"
		class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color,backdrop-filter] duration-500 ease-out"
	>
		<div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-2.5">
			<a href="#" class="relative flex shrink-0 items-center gap-3">
				<Image src={logo} alt="GA Food Wholesaler" class="h-11 w-auto md:h-12" />
				<span class="header-tagline hidden pl-3 text-xs leading-tight sm:block">
					Private Label<br />&amp; Brand Development
				</span>
			</a>
			<nav class="header-nav hidden items-center gap-8 text-sm md:flex">
				<a href="#metodo">Método</a>
				<a href="#cafe">Café Private Label</a>
				<a href="#segmentos">Para quem é</a>
				<a href="/blog/">Blog</a>
			</nav>
			<div class="flex items-center gap-3">
				<a
					href="#contato"
					class="inline-flex h-9 md:h-10 items-center justify-center rounded-full bg-primary px-4 md:px-5 text-xs md:text-sm font-medium text-primary-foreground shadow-[var(--shadow-lift-1)] transition-all hover:bg-primary/90 hover:shadow-[var(--shadow-lift-2)] active:scale-95"
				>
					<span class="hidden sm:inline">Fale com um Consultor GA</span>
					<span class="sm:hidden">Consultor GA</span>
				</a>
				<button id="mobile-menu-btn" class="md:hidden flex flex-col justify-center items-center gap-[4px] p-2 z-50 relative" aria-label="Abrir menu">
					<span class="block h-[2px] w-5 bg-foreground transition-all duration-300 origin-center"></span>
					<span class="block h-[2px] w-5 bg-foreground transition-all duration-300"></span>
					<span class="block h-[2px] w-5 bg-foreground transition-all duration-300 origin-center"></span>
				</button>
			</div>
		</div>
		<div id="mobile-menu" class="fixed inset-0 z-40 bg-background/95 backdrop-blur-md flex flex-col items-center justify-center gap-8 opacity-0 pointer-events-none transition-all duration-300 md:hidden">
			<a href="#metodo" class="text-2xl font-light text-foreground mobile-link">Método</a>
			<a href="#cafe" class="text-2xl font-light text-foreground mobile-link">Café Private Label</a>
			<a href="#segmentos" class="text-2xl font-light text-foreground mobile-link">Para quem é</a>
			<a href="/blog/" class="text-2xl font-light text-foreground mobile-link">Blog</a>
		</div>
		<div class="absolute inset-x-0 bottom-0 h-px overflow-hidden z-50" aria-hidden="true">
			<div id="scroll-progress" class="h-full w-full origin-left scale-x-0 bg-primary"></div>
		</div>
	</header>

	<main>
		<section class="relative isolate flex min-h-[100svh] flex-col justify-center overflow-hidden bg-background pt-24 pb-16">
			<div
				id="hero-atmosphere"
				class="absolute inset-y-0 right-0 z-0 w-full opacity-25 will-change-transform sm:opacity-60 md:w-[72%] md:opacity-100"
			>
				<HeroAtmosphere />
			</div>
			<div class="hero-grid relative z-20 mx-auto w-full max-w-6xl px-6">
				<h1
					data-reveal
					class="hero-titulo text-[clamp(2.5rem,5.6vw,4.75rem)] leading-[0.98] font-light tracking-[-0.04em] text-balance text-foreground"
				>
					Você tem a ideia.<br />Nós cuidamos do resto.
				</h1>
				<p
					data-reveal
					style="--reveal-delay:140ms"
					class="hero-sub max-w-xl text-lg leading-relaxed font-light text-foreground/75"
				>
					Não é só colocar sua marca em um produto. É construir um negócio que é seu, com a
					margem, o preço e o posicionamento que só você decide.
				</p>

				<div
					data-reveal
					style="--reveal-delay:200ms"
					class="hero-pacote mx-auto w-full max-w-[22rem] sm:max-w-[26rem] lg:mx-0 lg:max-w-none lg:justify-self-end"
				>
					<HeroPacote
						client:load
						src={pacoteOtimizado.src}
						width={pacoteOtimizado.attributes.width ?? 980}
						height={pacoteOtimizado.attributes.height ?? 1542}
					/>
				</div>

				<div data-reveal style="--reveal-delay:320ms" class="hero-acoes flex flex-wrap items-center gap-4">
						<a
							href="#contato"
							class="inline-flex h-12 items-center justify-center gap-2 rounded-full bg-primary px-7 text-sm font-medium text-primary-foreground shadow-[var(--shadow-lift-2)] transition-all hover:bg-primary/90 hover:shadow-[var(--shadow-lift-3)] active:scale-95"
						>
							Desenvolver minha marca própria
							<ArrowRight className="size-4" />
						</a>
						<a
							href="#contato"
							class="inline-flex h-12 items-center justify-center gap-2 rounded-full border border-border bg-background/70 px-7 text-sm font-medium text-foreground backdrop-blur-sm transition-colors hover:border-primary/60 hover:text-primary"
						>
							Fale com um Consultor GA
						</a>
				</div>
			</div>

			<div class="absolute bottom-0 left-6 z-20 h-24 w-px bg-gradient-to-b from-transparent to-primary/60 md:left-1/2"></div>
		</section>

		<section class="bg-background py-28">
			<div class="mx-auto grid max-w-6xl gap-14 px-6 lg:grid-cols-[1fr_1fr] lg:items-start lg:gap-20">
				<h2 class="text-4xl leading-[1.05] font-light tracking-[-0.04em] text-balance text-foreground sm:text-5xl">
					Colocar sua marca em um produto é só o começo. Construir uma marca de verdade é o
					negócio.
				</h2>
				<PontosValor client:visible />
			</div>
		</section>

		<section id="metodo" class="atmosphere-warm-soft bg-secondary py-28">
			<div class="mx-auto max-w-6xl px-6">
				<div class="mx-auto max-w-2xl text-center">
					<h2 class="text-4xl font-light tracking-[-0.04em] text-foreground sm:text-5xl">Private Label 360°.</h2>
					<p class="mt-5 text-lg text-muted-foreground">
						Uma estrutura integrada para desenvolver sua marca própria.
					</p>
				</div>

				<div class="mt-24">
					<RouteMethod stages={stages} client:visible />
				</div>
				
				<div class="mt-32 mx-auto max-w-3xl text-center" data-reveal>
					<p class="text-2xl font-light leading-relaxed text-foreground tracking-[-0.02em] md:text-3xl">
						Serviços independentes ou projeto completo, de acordo com a necessidade da marca. <br class="hidden md:block" />
						A GA é o parceiro para coordenar a jornada.
					</p>
					<div class="mt-10">
						<a
							href="#contato"
							class="inline-flex h-12 items-center justify-center gap-2 rounded-full bg-primary px-8 text-sm font-medium text-primary-foreground shadow-[var(--shadow-lift-2)] transition-all hover:bg-primary/90 hover:shadow-[var(--shadow-lift-3)] active:scale-95"
						>
							Fale com um Consultor GA
							<ArrowRight className="size-4" />
						</a>
					</div>
				</div>
			</div>
		</section>

		<section id="cafe" class="bg-background py-28 border-t border-border">
			<div class="mx-auto max-w-7xl px-6">
				<!-- Header -->
				<div class="mb-16 flex flex-col md:flex-row md:items-end justify-between gap-10 md:mb-24" data-reveal>
					<div class="max-w-3xl">
						<h2 class="text-4xl font-light leading-[1.05] tracking-[-0.04em] text-balance text-foreground sm:text-5xl">
							Desenvolvimento de Café Private Label.<br class="hidden md:block" />
							<span class="text-muted-foreground">Do grão à xícara exclusiva.</span>
						</h2>
					</div>
					<div class="max-w-md shrink-0">
						<p class="text-lg text-muted-foreground">
							Nossa vertical mais madura. Temos acesso direto aos produtores e estrutura completa de laboratório para desenhar o perfil sensorial exato da sua marca.
						</p>
					</div>
				</div>

				<!-- Bento 5-cells -->
				<div class="grid grid-cols-1 gap-4 md:grid-cols-3 md:gap-6">
					<!-- Cell 1 (Image 2-cols) -->
					<div class="relative min-h-[24rem] overflow-hidden rounded-3xl shadow-[var(--shadow-lift-2)] md:col-span-2" data-reveal style="--reveal-delay: 0ms">
						<Image src={blocoCafe1} alt="Curadoria de café verde nas fazendas" class="absolute inset-0 h-full w-full object-cover" />
					</div>

					<!-- Cell 2 (Text - Step 1) -->
					<div class="flex flex-col justify-end rounded-3xl bg-secondary p-10 shadow-[var(--shadow-lift-1)] md:col-span-1" data-reveal style="--reveal-delay: 100ms">
						<span class="mb-6 tabular-nums text-5xl font-light text-primary/30">1</span>
						<h3 class="mb-3 text-xl font-medium tracking-[-0.01em] text-foreground">Curadoria de Matéria-Prima</h3>
						<p class="text-sm leading-relaxed text-muted-foreground">
							Seleção nas origens em fazendas certificadas. Arábica, robusta e variedades exclusivas, com rastreabilidade total desde o plantio.
						</p>
					</div>

					<!-- Cell 3 (Text - Step 2) -->
					<div class="flex flex-col justify-end rounded-3xl bg-secondary p-10 shadow-[var(--shadow-lift-1)] md:col-span-1" data-reveal style="--reveal-delay: 200ms">
						<span class="mb-6 tabular-nums text-5xl font-light text-primary/30">2</span>
						<h3 class="mb-3 text-xl font-medium tracking-[-0.01em] text-foreground">Blends e Perfis de Torra</h3>
						<p class="text-sm leading-relaxed text-muted-foreground">
							Testes de torra em laboratório e cupping profissional para equilibrar acidez, corpo e doçura na criação de um perfil sensorial único.
						</p>
					</div>

					<!-- Cell 4 (Image 1-col) -->
					<div class="relative min-h-[24rem] overflow-hidden rounded-3xl shadow-[var(--shadow-lift-2)] md:col-span-1" data-reveal style="--reveal-delay: 300ms">
						<Image src={blocoCafe2} alt="Torra e provas sensoriais de café" class="absolute inset-0 h-full w-full object-cover" />
					</div>

					<!-- Cell 5 (Text - Step 3) -->
					<div class="flex flex-col justify-end rounded-3xl bg-primary p-10 text-primary-foreground shadow-[var(--shadow-lift-2)] md:col-span-1" data-reveal style="--reveal-delay: 400ms">
						<span class="mb-6 tabular-nums text-5xl font-light text-primary-foreground/30">3</span>
						<h3 class="mb-3 text-xl font-medium tracking-[-0.01em] text-primary-foreground">Especificações & Embalagem</h3>
						<p class="mb-8 text-sm leading-relaxed text-primary-foreground/80">
							Fichas técnicas detalhadas e design de embalagem focado na identidade da sua marca, garantindo exclusividade de ponta a ponta.
						</p>
						<a href="#contato" class="inline-flex w-fit items-center gap-2 text-sm font-medium hover:underline">
							Fale com um Consultor GA
							<ArrowRight className="size-4" />
						</a>
					</div>
				</div>
			</div>
		</section>

		<section id="segmentos" class="bg-muted py-28">
			<div class="mx-auto max-w-6xl px-6">
				<!-- Header -->
				<div class="mb-16 flex flex-col md:flex-row md:items-end justify-between gap-10" data-reveal>
					<div class="max-w-2xl">
						<h2 class="text-4xl font-light leading-[1.05] tracking-[-0.04em] text-balance text-foreground sm:text-5xl">
							Para diferentes modelos de negócio.<br class="hidden md:block" />
							<span class="text-muted-foreground">Uma única estrutura de ponta.</span>
						</h2>
					</div>
					<div class="max-w-md shrink-0">
						<p class="text-lg text-muted-foreground">
							Seja qual for o seu canal de vendas ou o momento da sua marca, nossa linha de produção adapta-se exatamente ao seu cenário.
						</p>
					</div>
				</div>

				<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
					{
						segmentos.map((segmento, i) => (
							<a
								href="#contato"
								data-reveal
								style={`--reveal-delay:${i * 80}ms`}
								class={`group relative block h-full min-h-[20rem] overflow-hidden rounded-2xl shadow-[var(--shadow-lift-1)] transition-shadow duration-500 hover:shadow-[var(--shadow-lift-3)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary ${segmento.className || ""}`}
							>
								<Image
									src={segmento.imagem}
									alt=""
									class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
									widths={[320, 480, 640]}
									sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
								/>
								<div class="absolute inset-0 bg-gradient-to-t from-foreground/85 via-foreground/10 to-transparent transition-opacity duration-500 group-hover:opacity-0" />
								<div class="absolute inset-0 bg-gradient-to-t from-foreground/95 via-foreground/35 to-foreground/5 opacity-0 transition-opacity duration-500 group-hover:opacity-100" />
								<div class="absolute right-5 bottom-5 left-5 transition-transform duration-500 ease-out group-hover:-translate-y-1">
									<p class="text-lg font-medium tracking-[-0.01em] text-primary-foreground">{segmento.titulo}</p>
									<p class="mt-1 text-sm text-primary-foreground/70">{segmento.descricao}</p>
									<span class="mt-3 flex items-center gap-1.5 text-sm font-medium text-primary-foreground opacity-0 transition-all duration-500 ease-out group-hover:opacity-100">
										Falar sobre esse cenário
										<ArrowRight className="size-3.5" />
									</span>
								</div>
							</a>
						))
					}
				</div>
			</div>
		</section>

		<section id="contato" class="atmosphere-warm bg-secondary py-28 relative overflow-hidden border-t border-border">
			<div class="mx-auto max-w-7xl px-6">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
					
					<!-- Left: Text and Info -->
					<div data-reveal>
						<p class="text-xs font-semibold tracking-[0.15em] text-primary uppercase mb-6">Por que a GA Food</p>
						<h2 class="text-4xl sm:text-5xl lg:text-[3.5rem] font-light leading-[1.05] tracking-[-0.04em] text-balance text-foreground mb-6">
							Um parceiro para reduzir complexidade.
						</h2>
						<p class="text-lg text-muted-foreground text-balance mb-12">
							Você coloca sua personalidade e energia no negócio.<br class="hidden xl:block" />
							Nós cuidamos da estrutura do projeto.
						</p>
						
						<!-- Grid Contacts -->
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-8 border-t border-border/60 pt-10">
							<div>
								<p class="text-[0.65rem] font-medium text-muted-foreground uppercase tracking-widest mb-2">E-mail</p>
								<a href="mailto:tranding@gafood.com.br" class="text-lg text-foreground hover:text-primary transition-colors font-medium">
									tranding@gafood.com.br
								</a>
							</div>
							<div>
								<p class="text-[0.65rem] font-medium text-muted-foreground uppercase tracking-widest mb-2">WhatsApp</p>
								<a href="https://wa.me/553196777753" target="_blank" class="text-lg text-foreground hover:text-primary transition-colors font-medium">
									+55 31 9677-7753
								</a>
							</div>
							<div>
								<p class="text-[0.65rem] font-medium text-muted-foreground uppercase tracking-widest mb-2">Site</p>
								<a href="https://gafood.com.br" target="_blank" class="text-lg text-foreground hover:text-primary transition-colors font-medium">
									gafood.com.br
								</a>
							</div>
							<div>
								<p class="text-[0.65rem] font-medium text-muted-foreground uppercase tracking-widest mb-2">Instagram</p>
								<a href="https://www.instagram.com/gafoodwholesaler/" target="_blank" class="text-lg text-foreground hover:text-primary transition-colors font-medium">
									@gafoodwholesaler
								</a>
							</div>
						</div>
					</div>

					<!-- Right: Interactive Chat -->
					<div data-reveal style="--reveal-delay: 200ms" class="relative">
						<!-- Glow background -->
						<div class="absolute -inset-4 bg-gradient-to-tr from-primary/10 via-primary/5 to-transparent rounded-[3rem] blur-xl"></div>
						<div class="relative">
							<ContactChat whatsappNumber="553196777753" client:visible />
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>

	<footer class="border-t border-border bg-secondary">
		<div class="mx-auto max-w-6xl px-6 pt-20 pb-10">
			<div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr]">
				<div>
					<Image src={logo} alt="GA Food Wholesaler" class="h-12 w-auto" />
					<p class="mt-4 max-w-xs text-sm leading-relaxed text-muted-foreground">
						Private Label &amp; Brand Development. Da ideia ao produto na prateleira, com uma
						estrutura só.
					</p>
				</div>

