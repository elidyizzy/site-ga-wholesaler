---
import "@/styles/global.css"

interface Props {
	title: string
	description: string
}

const { title, description } = Astro.props
---

<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<!--
			THESIS: "Da ideia à marca" vira uma rota contínua e literal atravessando
			a página — não uma lista de cards — recusando o scaffold-padrão de
			feature-cards B2B.
			OWN-WORLD: Branco/creme domina a página (paleta travada em
			DESIGN.md); o hero fotográfico Agro Premium é o único momento
			escuro, pela própria imagem, não pela paleta; #8A6D50 é o único
			acento quente, aplicado em CTAs e na rota do método; Geist Variable
			em escala grande e comprometida.
			STORY: O visitante entende que a GA Food conduz sua marca por um
			caminho real e definido — do diagnóstico ao lançamento — e age pedindo
			o diagnóstico.
			FIRST VIEWPORT: Hero em tela cheia, pouches + founder em primeiro
			plano, headline massiva sem eyebrow, a linha da rota nasce no rodapé
			do hero.
			FORM: Rota — estrutura nº1 da lista própria (índice 1, dealt), seed
			key 5c268776.
			FINISH: unreviewed and undocumented is unfinished; this build ends
			with the finish review, the verdict, DESIGN.md, and every shipping
			raster carrying its provenance.
		-->
		<slot />

		<script>
			// Header: transparente sobre a fotografia do hero, sólido depois dela.
			const header = document.getElementById("site-header")
			const hero = document.querySelector("main > section:first-child")

			if (header && hero) {
				const sentinel = document.createElement("div")
				sentinel.style.cssText = "position:absolute;top:80px;height:1px;width:1px;pointer-events:none"
				hero.appendChild(sentinel)

				new IntersectionObserver(
					([entry]) => header.classList.toggle("is-solid", !entry.isIntersecting),
					{ threshold: 0 }
				).observe(sentinel)
			} else if (header) {
				header.classList.add("is-solid")
			}

			// Reveal de entrada: uma vez por bloco, nunca repetido no scroll de volta.
			const revealables = document.querySelectorAll("[data-reveal]")

			if (revealables.length) {
				const revealObserver = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue
							entry.target.classList.add("is-revealed")
							revealObserver.unobserve(entry.target)
						}
					},
					{ rootMargin: "0px 0px -12% 0px", threshold: 0.05 }
				)

				for (const el of revealables) revealObserver.observe(el)
			}
		</script>
	</body>
</html>
